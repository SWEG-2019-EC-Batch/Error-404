


/*
   Task 1: Student course total
   
   (a) Inputs and Outputs:
       - Inputs: Assignment mark, midterm mark, final mark (each out of 100)
       - Outputs: Course total mark (1 decimal place) and Pass/Fail status
   
   (b) Process:
       1. Prompt the user to enter assignment, midterm, and final marks.
       2. Compute weighted total = (assignment * 0.20) + (midterm * 0.30) + (finalMark * 0.50).
       3. Determine status using the conditional operator: if total >= 50.0, "Pass", else "Fail".
       4. Print the total with 1 decimal place and the status.
*/

#include <iostream>
#include <iomanip>
#include <string>

using namespace std;

int main() {
    double assignment, midterm, finalMark;
    
    // Read inputs
    cout << "Enter assignment mark (out of 100): ";
    cin >> assignment;
    cout << "Enter midterm mark (out of 100): ";
    cin >> midterm;
    cout << "Enter final mark (out of 100): ";
    cin >> finalMark;
    
    // Compute course total
    double total = (assignment * 0.20) + (midterm * 0.30) + (finalMark * 0.50);
    
    // Determine pass or fail using the conditional operator (no if)
    string status = (total >= 50.0) ? "Pass" : "Fail";
    
    // Print results formatted to 1 decimal place
    cout << fixed << setprecision(1);
    cout << "Total: " << total << " and " << status << endl;
    
    return 0;
}